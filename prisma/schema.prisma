generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Score {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(20)
  timeMs    String
  createdAt DateTime @default(now())

  @@index([timeMs])
}
